{
  "manifest_version": 3,
  "name": "GitHub Enhanced",
  "version": "0.1.0",
  "description": "Flash-free tweaks for github.com",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_popup": "settings.html"
  },
  "options_ui": {
    "page": "settings.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "github.js"
      ],
      "css": [
        "github.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
